{
  "name": "adaptive-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "build:publishable": "node scripts/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "node scripts/release.ts",
    "release:dry": "node scripts/release.ts --dry-run",
    "maintenance": "node scripts/maintenance.ts",
    "maintenance:check": "node scripts/maintenance.ts check",
    "docs": "node scripts/docs.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.0"
  }
}
