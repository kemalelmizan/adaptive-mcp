{
  "name": "@adaptivemcp/runtime",
  "version": "0.1.0",
  "description": "Batteries-included Adaptive MCP runtime: wires telemetry, evaluation, routing, orchestration, approval, and the extension into one transport-agnostic loop.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@adaptivemcp/spec": "workspace:*",
    "@adaptivemcp/memory": "workspace:*",
    "@adaptivemcp/telemetry": "workspace:*",
    "@adaptivemcp/evaluation": "workspace:*",
    "@adaptivemcp/extension": "workspace:*",
    "@adaptivemcp/routing": "workspace:*",
    "@adaptivemcp/orchestration": "workspace:*",
    "@adaptivemcp/approval": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
