{
  "name": "@adaptivemcp/extension",
  "version": "0.2.1",
  "description": "Adaptive MCP extension: derives the YAML tools-metadata view from the SQLite SSOT and serves it to MCP clients.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@adaptivemcp/spec": "workspace:*",
    "@adaptivemcp/memory": "workspace:*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
