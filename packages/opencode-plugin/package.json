{
  "name": "@adaptivemcp/opencode-plugin",
  "version": "0.2.0",
  "description": "OpenCode plugin for Adaptive MCP - maps OpenCode hooks to Adaptive MCP telemetry and middleware",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@adaptivemcp/approval": "workspace:^",
    "@adaptivemcp/evaluation": "workspace:^",
    "@adaptivemcp/extension": "workspace:^",
    "@adaptivemcp/memory": "workspace:^",
    "@adaptivemcp/middleware": "workspace:^",
    "@adaptivemcp/orchestration": "workspace:^",
    "@adaptivemcp/routing": "workspace:^",
    "@adaptivemcp/telemetry": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
