{
  "name": "@adaptivemcp/examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable MCP server + client examples with the Adaptive MCP extension, plus improvement-over-time scenarios.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "server": "node --experimental-sqlite dist/server.js",
