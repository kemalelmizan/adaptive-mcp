    "scenario": "node --experimental-sqlite dist/scenario.js"
  },
  "dependencies": {
    "@adaptivemcp/spec": "workspace:*",
    "@adaptivemcp/memory": "workspace:*",
    "@adaptivemcp/telemetry": "workspace:*",
    "@adaptivemcp/evaluation": "workspace:*",
    "@adaptivemcp/extension": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
