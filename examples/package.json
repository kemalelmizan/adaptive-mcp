{
  "name": "@adaptivemcp/examples",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "description": "Runnable MCP server + client examples with the Adaptive MCP extension, plus improvement-over-time scenarios.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "server": "node dist/server.js",
    "client": "node dist/client.js",
    "client:local": "node -e \"import('./dist/client.js').then(m => m.runLocalLoop())\"",
    "quickstart": "node dist/quickstart.js",
    "scenario": "node dist/scenario.js",
    "scenario:store": "node dist/scenarios/store.js",
    "scenario:insights": "node dist/scenarios/insights.js",
    "scenario:annotation": "node dist/scenarios/annotation.js",
    "scenario:adaptive": "node dist/scenarios/adaptive.js",
    "scenario:execution-graph": "node dist/scenarios/execution-graph.js",
    "scenario:failure-cascade": "node dist/scenarios/failure-cascade.js",
    "scenario:middleware": "node dist/scenarios/middleware.js",
    "scenario:cost-optimization": "node dist/scenarios/cost-optimization.js",
    "scenario:debugging-deployment": "node dist/scenarios/debugging-deployment.js",
    "scenario:sampling-recommendations": "node dist/scenarios/sampling-recommendations.js",
    "scenario:decoding-policy": "node dist/scenarios/decoding-policy.js"
  },
  "dependencies": {
    "@adaptivemcp/spec": "workspace:*",
    "@adaptivemcp/memory": "workspace:*",
    "@adaptivemcp/telemetry": "workspace:*",
    "@adaptivemcp/evaluation": "workspace:*",
    "@adaptivemcp/extension": "workspace:*",
    "@adaptivemcp/routing": "workspace:*",
    "@adaptivemcp/orchestration": "workspace:*",
    "@adaptivemcp/approval": "workspace:*",
    "@adaptivemcp/thin-client": "workspace:*",
    "@adaptivemcp/graph-analysis": "workspace:*",
    "@adaptivemcp/runtime": "workspace:*",
    "@adaptivemcp/middleware": "workspace:*",
    "@adaptivemcp/mcp-binary": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
