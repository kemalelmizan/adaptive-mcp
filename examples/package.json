  "private": true,
  "type": "module",
  "description": "Runnable MCP server + client examples with the Adaptive MCP extension, plus improvement-over-time scenarios.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "server": "node dist/server.js",
    "client": "node dist/client.js",
    "quickstart": "node dist/quickstart.js",
    "scenario": "node dist/scenario.js",
    "scenario:store": "node dist/scenarios/store.js",
    "scenario:insights": "node dist/scenarios/insights.js",
    "scenario:annotation": "node dist/scenarios/annotation.js",
    "scenario:adaptive": "node dist/scenarios/adaptive.js"
  },
  "dependencies": {
    "@adaptivemcp/spec": "workspace:*",
    "@adaptivemcp/memory": "workspace:*",
    "@adaptivemcp/telemetry": "workspace:*",
    "@adaptivemcp/evaluation": "workspace:*",
    "@adaptivemcp/extension": "workspace:*",
    "@adaptivemcp/routing": "workspace:*",
    "@adaptivemcp/orchestration": "workspace:*",
    "@adaptivemcp/approval": "workspace:*",
    "@adaptivemcp/thin-client": "workspace:*",
    "@adaptivemcp/runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
